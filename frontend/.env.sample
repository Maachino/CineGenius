# URL du backend Express — utilisé dans React avec import.meta.env.VITE_BACKEND_URL
# En développement local :
VITE_BACKEND_URL=http://localhost:5001
# En production : VITE_BACKEND_URL=https://api.votredomaine.fr

# IMPORTANT : NE PAS ajouter VITE_TMDB_API_KEY ici !
# La clé TMDB est maintenant gérée côté serveur (backend/.env) pour la sécurité.
