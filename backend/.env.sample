# ===== CONFIGURATION SERVEUR =====
APP_PORT=5001
NODE_ENV=development

# ===== FRONTEND (CORS) =====
# URL du frontend autorisée par CORS
FRONTEND_URL=http://localhost:3000
# En production : FRONTEND_URL=https://votredomaine.fr

# ===== BASE DE DONNÉES MySQL =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=cinegenie_user
DB_PASSWORD=changez_ce_mot_de_passe
DB_NAME=cinegenie_db

# ===== API TMDB (The Movie Database) =====
# Obtenez votre clé gratuite sur : https://www.themoviedb.org/settings/api
# ATTENTION : Ne jamais exposer cette clé côté frontend !
TMDB_API_KEY=votre_cle_tmdb_ici

# ===== JWT (Authentification — Phase 3) =====
# Générez un secret fort : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT_SECRET=votre_secret_jwt_64_caracteres_minimum
# JWT_EXPIRES_IN=7d

# ===== OAUTH GOOGLE (Optionnel — Phase 3) =====
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx
