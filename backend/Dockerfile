# Dockerfile backend
FROM node:20-alpine

WORKDIR /usr/src/app

ARG DB_HOST=${DB_HOST}
ENV DB_HOST=${DB_HOST}
ARG DB_USER=${DB_USER}
ENV DB_USER=${DB_USER}
ARG DB_PASSWORD=${DB_PASSWORD}
ENV DB_PASSWORD=${DB_PASSWORD}
ARG DB_NAME=${DB_NAME}
ENV DB_NAME=${DB_NAME}
ARG TMDB_API_KEY=${TMDB_API_KEY}
ENV TMDB_API_KEY=${TMDB_API_KEY}

COPY ./backend .

RUN npm install

CMD [ "npm", "start" ]